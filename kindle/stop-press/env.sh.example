#!/bin/sh
# Copy to env.sh and fill in. Read by paper.sh on the Kindle.

# Your server's /kindle.png address, with the token if you set one in stop-press.toml.
# On your home network:  http://192.168.1.20:8000/kindle.png?t=your-token
# Behind HTTPS:          https://paper.example.com/kindle.png?t=your-token
export DASH_URL="http://192.168.1.20:8000/kindle.png?t=change-me"

# Pinged to tell when Wi-Fi is back after a sleep.
export WIFI_TEST_IP=1.1.1.1

# When the sleeping Kindle wakes to show a fresh page (cron syntax, your local time). Overnight gaps of an
# hour or more show sleeping.png instead.
export REFRESH_SCHEDULE="*/15 6-23 * * *"
export TIMEZONE="Europe/London"
# The same zone as a POSIX TZ string (the Kindle 4 has no zone database), used to date the editions.
# UK: GMT0BST,M3.5.0/1,M10.5.0   US Eastern: EST5EDT,M3.2.0,M11.1.0   Central Europe: CET-1CEST,M3.5.0,M10.5.0/3
export POSIX_TZ="GMT0BST,M3.5.0/1,M10.5.0"

# Name of the edition files in your library.
export EDITION_NAME="Stop Press"
